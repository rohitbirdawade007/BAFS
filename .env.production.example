# ============================================================
# BIRDAWADE ASSOCIATES & FINANCIAL SERVICES (BAFS)
# Production Environment Configuration Template
# ============================================================
# Instructions:
# 1. Copy this file to .env.production:
#    cp .env.production.example .env.production
# 2. Generate strong cryptographically secure keys:
#    APP_SECRET_KEY:  openssl rand -hex 32
#    JWT_SECRET_KEY:  openssl rand -hex 64
#    POSTGRES_PASS:   openssl rand -hex 24
#    MINIO_KEYS:      openssl rand -hex 16
# 3. Fill in your actual domain, SMTP, and SMS credentials.
# 4. NEVER commit .env.production to Git.
# ============================================================

# ── Application ───────────────────────────────────────────────
APP_ENV=production
APP_NAME="Birdawade Associates & Financial Services"
APP_VERSION=1.0.0
DEBUG=false
APP_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32

# ── Domain & API ──────────────────────────────────────────────
# Replace with your actual production domain(s)
ALLOWED_ORIGINS=https://birdawade.com,https://www.birdawade.com
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000

# ── Database (PostgreSQL) ─────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bafs_db
POSTGRES_USER=bafs_admin
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://bafs_admin:REPLACE_WITH_SECURE_POSTGRES_PASSWORD@db:5432/bafs_db

# ── Redis (Job Queue & Rate Limiting) ─────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Document Storage (MinIO or AWS S3) ────────────────────────
# Option A: Self-hosted MinIO (Default in Docker Compose)
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET_DOCUMENTS=bafs-documents
MINIO_USE_SSL=false

# Option B: AWS S3 (Uncomment if using AWS in production)
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=ap-south-1
# S3_BUCKET_DOCUMENTS=bafs-production-documents

# ── Authentication & Security ─────────────────────────────────
JWT_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=true

# ── SMS / OTP Service (MSG91) ─────────────────────────────────
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID_OTP=YOUR_MSG91_TEMPLATE_ID
MSG91_SENDER_ID=BAFSEC

# ── Email Service (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY
EMAIL_FROM_ADDRESS=support@birdawade.com
EMAIL_FROM_NAME="Birdawade Associates"

# ── WhatsApp Business API (Optional) ──────────────────────────
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_OTP_REQUESTS_PER_HOUR=5
RATE_LIMIT_LEAD_SUBMISSIONS_PER_HOUR=10
RATE_LIMIT_API_REQUESTS_PER_MINUTE=60

# ── File Upload Policy ────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
SIGNED_URL_EXPIRE_SECONDS=900

# ── Frontend Configuration ────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME="Birdawade Associates & Financial Services"
NEXT_PUBLIC_SUPPORT_EMAIL=support@birdawade.com
NEXT_PUBLIC_SUPPORT_PHONE=+91-9623298281

# ── Background Worker (ARQ) ───────────────────────────────────
ARQ_WORKER_CONCURRENCY=10
ARQ_MAX_RETRIES=3

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
