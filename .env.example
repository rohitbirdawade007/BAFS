# ============================================================
# BIRDAWADE ASSOCIATES & FINANCIAL SERVICES — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME="Birdawade Associates & Financial Services"
APP_VERSION=1.0.0
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
DEBUG=true

# --- API ---
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Database (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=bafs_db
POSTGRES_USER=bafs_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+asyncpg://bafs_user:CHANGE_ME_STRONG_PASSWORD@db:5432/bafs_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- MinIO / S3-compatible Storage ---
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET_DOCUMENTS=bafs-documents
MINIO_USE_SSL=false
# For production AWS S3:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# S3_BUCKET_DOCUMENTS=

# --- Authentication ---
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# --- SMS / OTP Provider (MSG91) ---
# Leave blank to use development mock (OTPs printed to logs)
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID_OTP=
MSG91_SENDER_ID=BAFSEC

# --- Email (SMTP) ---
# Leave blank to disable email in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@birdawade.com
EMAIL_FROM_NAME="Birdawade Associates"

# --- WhatsApp Business API (deferred) ---
WHATSAPP_PROVIDER=disabled
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Rate Limiting ---
RATE_LIMIT_OTP_REQUESTS_PER_HOUR=5
RATE_LIMIT_LEAD_SUBMISSIONS_PER_HOUR=10
RATE_LIMIT_API_REQUESTS_PER_MINUTE=60

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
SIGNED_URL_EXPIRE_SECONDS=900

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME="Birdawade Associates & Financial Services"
NEXT_PUBLIC_SUPPORT_EMAIL=support@birdawade.com
NEXT_PUBLIC_SUPPORT_PHONE=+91-XXXXXXXXXX

# --- Background Jobs (ARQ) ---
ARQ_WORKER_CONCURRENCY=10
ARQ_MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Security ---
BCRYPT_ROUNDS=12
SESSION_COOKIE_SECURE=false
# Set true in production (requires HTTPS)
