# ============================================================
# BAFS — Root Git Ignore
# ============================================================

# ── Secrets & Environment Configurations ──────────────────────
.env
.env.*
!.env.example
!.env.production.example
frontend/.env.local
frontend/.env.*.local

# ── Node.js & Next.js ─────────────────────────────────────────
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
*.tsbuildinfo
next-env.d.ts.local

# ── Python ────────────────────────────────────────────────────
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!mobile/lib/
!mobile/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
backend/venv/
backend/.venv/
env/
ENV/

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ── Docker & Volume Data ──────────────────────────────────────
postgres_data/
redis_data/
minio_data/

# ── SSL Certificates ──────────────────────────────────────────
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem
*.key
*.pem

# ── Logs & OS ─────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/

# ── Mobile & Flutter ──────────────────────────────────────────
**/android/key.properties
**/android/*.jks
**/android/*.keystore
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/ios/Podfile.lock
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Runner/GeneratedPluginRegistrant.h
mobile/ios/Runner/GeneratedPluginRegistrant.m
